{
  "name": "ali-ielts-reel",
  "version": "1.0.0",
  "private": true,
  "description": "Animated Uzbek IELTS motivation reel starring ALI \u2014 built with Remotion + React + TypeScript",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "voice": "python3 scripts/generate_voiceover.py",
    "sfx": "python3 scripts/generate_audio_assets.py",
    "assets": "npm run voice && npm run sfx",
    "typecheck": "tsc --noEmit",
    "render": "bash scripts/render.sh",
    "still": "remotion still src/index.ts Thumbnail out/thumbnail.png",
    "qa": "node scripts/sample-frames.mjs 15"
  },
  "dependencies": {
    "@fontsource/montserrat": "5.2.8",
    "@remotion/cli": "4.0.543",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.543",
    "@remotion/bundler": "4.0.543",
    "@remotion/renderer": "4.0.543"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
